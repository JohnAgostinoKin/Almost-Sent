# Get a key at https://openrouter.ai/keys
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat/completions endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# v3's two generator calls (lib/prompt.js) — the primary call writes one
# candidate per lane for all eight primary lanes, the wildcard call writes
# the raunchy and gross candidates. Don't guess — run `npm run bake` (it
# bakes the current primary prompt across whatever models BAKE_MODELS
# names, temperature is 1.0) and read bake-results.md before setting
# either of these. gpt-5.4, not Sol — Sol measured 6.5s+ as the primary
# generator in production even with reasoning:{effort:"minimal"} applied
# (see lib/reasoning.js), well past lib/llm.js's TIMEOUT_MS; gpt-5.4
# measured 3.9s with no override needed.
GENERATOR_MODEL=openai/gpt-5.4
WILDCARD_MODEL=nousresearch/hermes-4-405b

# The taste judge (lib/judge.js's judgeCandidates) — one call per request
# reviewing every safety-cleared candidate, gating and scoring. gpt-5.4
# for the same reason as GENERATOR_MODEL above — Sol measured 9.2s here
# in production, past TASTE_TIMEOUT_MS.
JUDGE_MODEL=openai/gpt-5.4

# The safety judge (lib/judge.js's judgeOneLine) — one call per candidate,
# drops anything that shouldn't ship at all before the taste judge above
# ever sees it. gpt-5.4-nano, not mistral-small — mistral-small measured
# 4.9s across ten parallel per-candidate calls in production; nano is the
# fast option here, mistral-small is now SAFETY_FALLBACK_MODEL instead
# (not env-configurable — see lib/judge.js).
SAFETY_MODEL=openai/gpt-5.4-nano

# The input-side crisis pre-check (lib/crisis.js) — a semantic layer past
# lib/block.js's keyword list, for phrasing that reads as a real crisis
# signal without any single flaggable word. Not the same job as
# SAFETY_MODEL above (that judges generated output; this judges the
# pasted text itself, before generation even starts).
CRISIS_MODEL=mistralai/mistral-small-2603

# Fallback model. If GENERATOR_MODEL or WILDCARD_MODEL errors or refuses
# outright, api/draft.js retries once against this model instead. Not
# configurable via env — set in code (api/draft.js's FALLBACK_MODEL).

# Optional. Comma-separated, overrides the three default bake-off models.

BAKE_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.4,google/gemini-3.5-flash

# Optional. Used by api/draft.js (the incoming line, in `inbox`) and
# api/event.js (anonymous interaction events, in `events` — device id,
# event name, small meta only, never the text).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Guards api/cron/cleanup.js (the nightly inbox-retention job —
# see vercel.json's `crons` entry): when set, Vercel attaches this exact
# value as `Authorization: Bearer <CRON_SECRET>` on its own scheduled
# invocations, and the endpoint rejects anyone else calling the path
# directly. With no CRON_SECRET set, the guard is skipped entirely.
CRON_SECRET=
