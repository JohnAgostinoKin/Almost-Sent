# Get a key at https://openrouter.ai/keys
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat/completions endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Which model api/draft.js uses. Don't guess — run `npm run bake` (it
# prints every model id OpenRouter currently serves, three times over,
# temperature is 1.0) and read bake-results.md, then set this.
LLM_MODEL=mistralai/mistral-large-2512

# Optional. Comma-separated, overrides the three default bake-off models.
# BAKE_MODELS=openai/gpt-oss-120b,meta-llama/llama-3.3-70b-instruct,qwen/qwen3-32b

# Optional, for logging the incoming line only (see api/draft.js).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
