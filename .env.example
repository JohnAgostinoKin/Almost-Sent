# Get a key at https://openrouter.ai/keys
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat/completions endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Which model api/draft.js uses. Don't guess — run `npm run bake` (it
# prints every model id OpenRouter currently serves, three times over,
# temperature is 1.0) and read bake-results.md, then set this.
LLM_MODEL=nousresearch/hermes-4-405b

# Fallback model. If LLM_MODEL errors or refuses outright, api/draft.js
# retries once against this model instead. Not configurable via env — set
# in code (api/draft.js's fromAi).

# Optional. Comma-separated, overrides the three default bake-off models.

BAKE_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.4,google/gemini-3.5-flash

# Optional. Used by api/draft.js (the incoming line, in `inbox`) and
# api/event.js (anonymous interaction events, in `events` — device id,
# event name, small meta only, never the text).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
