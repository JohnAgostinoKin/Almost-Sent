# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Which model api/draft.js uses. Don't guess — run `npm run bake`
# (three times, temperature is 1.0) and read bake-results.md, then set this.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Comma-separated, overrides the three default bake-off models.
# BAKE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3-32b

# Optional, for logging the incoming line only (see api/draft.js).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
