# Get a key at https://openrouter.ai/keys
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat/completions endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# v4's two generator calls (lib/prompt.js), split by strength, not by
# lane count — WILDCARD_MODEL (Hermes) writes the crude voices (shock,
# raunchy, deranged, gross, wildcard — a fixed seven-candidate plan every
# call); GENERATOR_MODEL (GPT-5.4) writes the clever ones (confession,
# dark, plus absurd on an escalation refetch only). Same two env vars, same
# defaults, as v3 — only what each model is asked to write changed. Don't
# guess if you're considering swapping either — run `npm run bake` (it
# bakes GENERATOR_MODEL's own confession/dark prompt across whatever
# models BAKE_MODELS names, temperature is 1.0) and read bake-results.md
# first. gpt-5.4, not Sol, for GENERATOR_MODEL — Sol measured 6.5s+ as the
# generator in production even with reasoning:{effort:"minimal"} applied
# (see lib/reasoning.js), well past lib/llm.js's TIMEOUT_MS; gpt-5.4
# measured 3.9s with no override needed.
GENERATOR_MODEL=openai/gpt-5.4
WILDCARD_MODEL=nousresearch/hermes-4-405b

# The taste judge (lib/judge.js's judgeCandidates) — every safety-cleared
# candidate split into two parallel batches, gated then scored on
# reaction/specificity/interchangeable (v4 — see lib/judge.js's own
# header) in a compact one-line-per-candidate format (no JSON, no
# mechanism field — see lib/judge.js's buildTasteJudgeRequest). gpt-5.4
# for the same reason
# as GENERATOR_MODEL above — Sol measured 9.2s here in production, past
# TASTE_TIMEOUT_MS. Gets NO reasoning override despite being a gpt-5.x
# model — see lib/reasoning.js: a short structured answer is exactly the
# small-max_tokens shape that breaks reasoning:{effort:"minimal"}.
JUDGE_MODEL=openai/gpt-5.4

# The safety judge (lib/judge.js's judgeOneLine) — one call per candidate,
# drops anything that shouldn't ship at all before the taste judge above
# ever sees it. gpt-5.4-nano, not mistral-small — mistral-small measured
# 4.9s across ten parallel per-candidate calls in production; nano is the
# fast option here, mistral-small is now SAFETY_FALLBACK_MODEL instead
# (not env-configurable — see lib/judge.js). Also gets no reasoning
# override, same reason as JUDGE_MODEL above — confirmed with a real call
# that "minimal" reasoning burns nano's whole 16-token budget and returns
# nothing usable; omitting the field entirely is what actually works.
SAFETY_MODEL=openai/gpt-5.4-nano

# The input-side crisis pre-check (lib/crisis.js) — a semantic layer past
# lib/block.js's keyword list, for phrasing that reads as a real crisis
# signal without any single flaggable word. Not the same job as
# SAFETY_MODEL above (that judges generated output; this judges the
# pasted text itself, before generation even starts).
CRISIS_MODEL=mistralai/mistral-small-2603

# Fallback model. If GENERATOR_MODEL or WILDCARD_MODEL errors or refuses
# outright, api/draft.js retries once against this model instead. Not
# configurable via env — set in code (api/draft.js's FALLBACK_MODEL).

# Optional. Regenerate-if-weak's q floor (api/draft.js) — a first round
# scoring below this on q, OR scoring reaction < 6 for position 1, spends
# one extra round before shipping. Default 11 is a PROVISIONAL rescale for
# v4's smaller q range (2*reaction + specificity - interchangeable maxes
# at 30, not v3's ~80) — the v4 brief (section 6) calls for running the
# full 200-input corpus and setting this at the 30th percentile of real
# top scores instead. Don't trust 11 as calibrated; it's a placeholder.
REGEN_THRESHOLD=11

# Optional. Comma-separated, overrides the three default bake-off models.

BAKE_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.4,google/gemini-3.5-flash

# Optional. Used by api/draft.js (the incoming line, in `inbox`) and
# api/event.js (anonymous interaction events, in `events` — device id,
# event name, small meta only, never the text).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Guards api/cron/cleanup.js (the nightly inbox-retention job —
# see vercel.json's `crons` entry): when set, Vercel attaches this exact
# value as `Authorization: Bearer <CRON_SECRET>` on its own scheduled
# invocations, and the endpoint rejects anyone else calling the path
# directly. With no CRON_SECRET set, the guard is skipped entirely.
CRON_SECRET=
